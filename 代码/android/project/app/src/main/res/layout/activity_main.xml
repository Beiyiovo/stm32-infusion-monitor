<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1A2B"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="输液状态监测"
        android:textColor="#E8F1FF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvConn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="未连接"
        android:textColor="#8FA6C4"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTempLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="温度"
        android:textColor="#8FA6C4"
        android:textSize="14sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvConn"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--.-"
        android:textColor="#E8F1FF"
        android:textSize="52sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvTempLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTempUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="℃"
        android:textColor="#8FA6C4"
        android:textSize="18sp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@id/tvTemp"
        app:layout_constraintStart_toEndOf="@id/tvTemp" />

    <TextView
        android:id="@+id/tvWeightLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="剩余重量"
        android:textColor="#8FA6C4"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTemp"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvWeight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="----"
        android:textColor="#E8F1FF"
        android:textSize="52sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvWeightLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvWeightUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="g"
        android:textColor="#8FA6C4"
        android:textSize="18sp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@id/tvWeight"
        app:layout_constraintStart_toEndOf="@id/tvWeight" />

    <TextView
        android:id="@+id/tvDropLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="滴速"
        android:textColor="#8FA6C4"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvWeight"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvDrop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="---"
        android:textColor="#E8F1FF"
        android:textSize="52sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvDropLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvDropUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="滴/分"
        android:textColor="#8FA6C4"
        android:textSize="18sp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@id/tvDrop"
        app:layout_constraintStart_toEndOf="@id/tvDrop" />

    <TextView
        android:id="@+id/tvState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="待机"
        android:textColor="#8FA6C4"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="10dp"
        android:background="#16263C"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/tvDrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="连接 192.168.4.1:8080"
        android:textSize="16sp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/tvState"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
