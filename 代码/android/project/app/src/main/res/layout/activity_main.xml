<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="22dp"
    android:paddingBottom="18dp">

    <!-- 顶部：标题 + 连接状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="输液状态监测"
            android:textColor="#F2F7FF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <View
            android:id="@+id/dotConn"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/dot_off" />

        <TextView
            android:id="@+id/tvConn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="未连接"
            android:textColor="#8FA6C4"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 温度仪表盘 -->
    <com.example.test.GaugeView
        android:id="@+id/gaugeTemp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:minHeight="220dp" />

    <!-- 重量 / 滴速 两张卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginEnd="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="剩余重量"
                android:textColor="#8FA6C4"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="----"
                    android:textColor="#F2F7FF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="g"
                    android:textColor="#8FA6C4"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.example.test.LevelBarView
                android:id="@+id/barWeight"
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginStart="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="滴速"
                    android:textColor="#8FA6C4"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/dotDrop"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_on" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvDrop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textColor="#F2F7FF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="滴/分"
                    android:textColor="#8FA6C4"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:id="@+id/barDrop"
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg" />
        </LinearLayout>
    </LinearLayout>

    <!-- 状态条 -->
    <TextView
        android:id="@+id/tvState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/card_bg"
        android:gravity="center"
        android:padding="14dp"
        android:text="待机"
        android:textColor="#8FA6C4"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <!-- 连接按钮 -->
    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_bg"
        android:text="连接设备"
        android:textColor="#08131F"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:stateListAnimator="@null" />

</LinearLayout>
