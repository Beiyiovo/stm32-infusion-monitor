<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="14dp">

    <!-- 顶部 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="输液状态监测"
            android:textColor="#F2F7FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <View
            android:id="@+id/dotConn"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_off" />

        <TextView
            android:id="@+id/tvConn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="未连接"
            android:textColor="#8FA6C4"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 主视觉：克重 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="14dp"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="剩余药液重量"
            android:textColor="#8FA6C4"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="----"
                android:textColor="#F2F7FF"
                android:textSize="64sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="10dp"
                android:text="g"
                android:textColor="#8FA6C4"
                android:textSize="18sp" />
        </LinearLayout>

        <com.example.test.LevelBarView
            android:id="@+id/barWeight"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvPercent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="液位 --"
                android:textColor="#8FA6C4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvEstimate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="预计剩余 --"
                android:textColor="#35D0BA"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 温度 + 滴速 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:layout_marginEnd="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="液体温度"
                android:textColor="#8FA6C4"
                android:textSize="12sp" />

            <com.example.test.GaugeView
                android:id="@+id/gaugeTemp"
                android:layout_width="match_parent"
                android:layout_height="132dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:layout_marginStart="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="滴速"
                    android:textColor="#8FA6C4"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/dotDrop"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/dot_on" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="18dp">

                <TextView
                    android:id="@+id/tvDrop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textColor="#F2F7FF"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp"
                    android:text="滴/分"
                    android:textColor="#8FA6C4"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="累计 0 滴"
                android:textColor="#607894"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 趋势 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="12dp"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="重量趋势（最近 2 分钟）"
            android:textColor="#8FA6C4"
            android:textSize="12sp" />

        <com.example.test.TrendView
            android:id="@+id/trend"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- 状态 + 按钮 -->
    <TextView
        android:id="@+id/tvState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_bg"
        android:gravity="center"
        android:padding="12dp"
        android:text="待机"
        android:textColor="#8FA6C4"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_bg"
        android:text="连接设备"
        android:textColor="#08131F"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:stateListAnimator="@null" />

</LinearLayout>
